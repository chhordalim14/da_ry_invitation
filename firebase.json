{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.mp3",
        "headers": [
          { "key": "Content-Type", "value": "audio/mpeg" },
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
